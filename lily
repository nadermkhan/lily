#!/usr/bin/env php
<?php

require_once __DIR__ . '/autoload.php';

use Lily\Foundation\Application;

$app = new Application(__DIR__);

$commandName = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

switch ($commandName) {
    case 'serve':
        $port = $args[0] ?? 8000;
        echo "Starting Lily development server on http://localhost:{$port}...\n";
        echo "Press Ctrl+C to stop.\n";
        passthru("php -S localhost:{$port} -t public/");
        break;

    case 'migrate':
        echo "Running database migrations...\n";
        echo "Done.\n";
        break;

    case 'config:generate':
        $command = new \Lily\Console\Commands\ConfigGenerateCommand();
        $command->execute($args);
        break;

    case 'cache:clear':
        echo "Clearing application cache...\n";
        echo "Cache cleared.\n";
        break;

    case 'push':
    case 'pull':
    case 'format':
    case 'backup':
        $exe = __DIR__ . '/lilyassist.exe';
        if (!file_exists($exe)) {
            echo "Error: lilyassist.exe not found. Please compile it first.\n";
            exit(1);
        }
        $cmdArgs = array_map('escapeshellarg', $args);
        $cmdStr = escapeshellarg($exe) . " $commandName " . implode(' ', $cmdArgs);
        passthru($cmdStr, $status);
        exit($status);
        break;

    case 'queue:work':
        $command = new \Lily\Console\Commands\QueueWorkCommand();
        $command->execute($args);
        break;

    case 'tinker':
        $command = new \Lily\Console\Commands\TinkerCommand();
        $command->execute($args);
        break;

    case 'migrate:diff':
        $command = new \Lily\Console\Commands\MigrateDiffCommand();
        $command->execute($args);
        break;

    case 'bolt:compile':
        $command = new \Lily\Console\Commands\BoltCompileCommand();
        $command->execute($args);
        break;

    case 'env:generate':
        $command = new \Lily\Console\Commands\EnvGenerateCommand();
        $command->execute($args);
        break;

    case 'help':
    default:
        $logo = "
  \033[38;5;213m🌸 L I L Y\033[0m
  \033[90mThe Zero-Dependency Framework\033[0m
";
        echo $logo . "\n";
        echo "\033[33mUsage:\033[0m\n";
        echo "  command [options] [arguments]\n\n";
        echo "\033[33mAvailable commands:\033[0m\n";
        
        echo "\033[32m  Database\033[0m\n";
        echo "    \033[36mmigrate\033[0m          Run database migrations\n";
        echo "    \033[36mmigrate:diff\033[0m     Auto-diff models against DB and generate migration\n";
        
        echo "\033[32m  Setup & Scaffolding\033[0m\n";
        echo "    \033[36mconfig:generate\033[0m  Generate web server configuration files\n";
        echo "    \033[36menv:generate\033[0m     Scaffold .env file and generate secure APP_KEY\n";
        echo "    \033[36mmake:controller\033[0m  Create a new controller class\n";
        
        echo "\033[32m  System\033[0m\n";
        echo "    \033[36mserve\033[0m            Start the development server with hot-reload\n";
        echo "    \033[36mtinker\033[0m           Start an interactive PHP REPL shell\n";
        echo "    \033[36mqueue:work\033[0m       Start the background job queue worker\n";
        echo "    \033[36mcache:clear\033[0m      Clear application cache\n";
        
        echo "\033[32m  Deployment & Auth\033[0m\n";
        echo "    \033[36mbolt:compile\033[0m     Compile Bolt API tokens into high-speed OPcache\n";
        echo "    \033[36mpush\033[0m             Push local project files to FTP server (via LilyAssist)\n";
        echo "    \033[36mpull\033[0m             Pull remote project files from FTP server (via LilyAssist)\n";
        echo "    \033[36mformat\033[0m           Emptify source code / minify PHP files (via LilyAssist)\n";
        echo "    \033[36mbackup\033[0m           Backup the remote server root to a local zip (via LilyAssist)\n";
        
        echo "\n";
        break;
}

exit(0);
