#!/usr/bin/env php
<?php

require_once __DIR__ . '/autoload.php';

use Lily\Foundation\Application;

$app = new Application(__DIR__);

$commandName = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

echo "Lily Framework Console\n-----------------------\n";

switch ($commandName) {
    case 'serve':
        $port = $args[0] ?? 8000;
        echo "Starting Lily development server on http://localhost:{$port}...\n";
        echo "Press Ctrl+C to stop.\n";
        passthru("php -S localhost:{$port} -t public/");
        break;

    case 'migrate':
        echo "Running database migrations...\n";
        echo "Done.\n";
        break;

    case 'config:generate':
        $command = new \Lily\Console\Commands\ConfigGenerateCommand();
        $command->execute($args);
        break;

    case 'cache:clear':
        echo "Clearing application cache...\n";
        echo "Cache cleared.\n";
        break;

    case 'push':
        $command = new \Lily\Console\Commands\PushCommand();
        $command->execute($args);
        break;

    case 'pull':
        $command = new \Lily\Console\Commands\PullCommand();
        $command->execute($args);
        break;

    case 'queue:work':
        $command = new \Lily\Console\Commands\QueueWorkCommand();
        $command->execute($args);
        break;

    case 'tinker':
        $command = new \Lily\Console\Commands\TinkerCommand();
        $command->execute($args);
        break;

    case 'migrate:diff':
        $command = new \Lily\Console\Commands\MigrateDiffCommand();
        $command->execute($args);
        break;

    case 'bolt:compile':
        $command = new \Lily\Console\Commands\BoltCompileCommand();
        $command->execute($args);
        break;

    case 'env:generate':
        $command = new \Lily\Console\Commands\EnvGenerateCommand();
        $command->execute($args);
        break;

    case 'help':
    default:
        echo "Available commands:\n";
        echo "  migrate          Run database migrations\n";
        echo "  migrate:diff     Auto-diff models against DB and generate migration\n";
        echo "  config:generate  Generate web server configuration files\n";
        echo "  env:generate     Scaffold .env file and generate secure APP_KEY\n";
        echo "  cache:clear      Clear application cache\n";
        echo "  push             Push local project files to FTP server\n";
        echo "  pull             Pull remote project files from FTP server\n";
        echo "  queue:work       Start the background job queue worker\n";
        echo "  tinker           Start interactive PHP REPL\n";
        echo "  bolt:compile     Manually recompile Bolt tokens cache\n";
        break;
}

exit(0);
